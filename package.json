{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "node_modules/.bin/ng",
    "clean:webapp": "rm -rf build/resources/main/static && rm -rf .angular/cache",
    "clean:website": "rm -rf dist/website && rm -rf .angular/cache",
    "merge:i18n": "node merge-i18n.js",
    "webapp:dev": "yarn merge:i18n && yarn ng cache clean && yarn ng serve webapp --poll=2000",
    "website:dev": "yarn ng cache clean && yarn ng serve website",
    "webapp:build:prod": "yarn clean:webapp && yarn ng build webapp --configuration production",
    "webapp:build:dev": "yarn clean:webapp && yarn ng build webapp --configuration development",
    "website:build:prod": "yarn clean:website && yarn ng build website --configuration production",
    "website:build:dev": "yarn clean:website && yarn ng build website --configuration development",
    "start": "yarn webapp:dev",
    "test": "yarn ng test",
    "serve:ssr:website": "node dist/website/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "21.0.3",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "21.1.0-rc.0",
    "@angular/core": "21.1.0-rc.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "21.0.3",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "21.1.0-rc.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.1.4",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ng-select/ng-select": "^21.1.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "ngx-dropzone": "^3.1.0",
    "ngx-mask": "^21.0.1",
    "ngx-toastr": "^19.1.0",
    "ngx-translate-multi-http-loader": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/uuid": "^11.0.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
